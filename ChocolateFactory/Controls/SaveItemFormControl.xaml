<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChocolateFactory.Controls.SaveItemFormControl"
             x:Name="this">
    <ScrollView BindingContext="{x:Reference this}">
        <VerticalStackLayout Spacing="10">
            <VerticalStackLayout>
                <Label Text="Название"
                       TextColor="Black"/>
                <Entry Text="{Binding Item.Name}"
                       TextColor="Black"
                       Placeholder="Ввести значение"
                       PlaceholderColor="Gray"/>
            </VerticalStackLayout>
            <VerticalStackLayout>
                <Label Text="Изображение"
                       TextColor="Black"/>
                <Image x:Name="itemImagePath"
                       Source="add_image.png"
                       HeightRequest="35"
                       Aspect="AspectFit"/>
                <Button Text="Выбрать"
                        HorizontalOptions="Center"
                        BackgroundColor="LightBlue"
                        MinimumHeightRequest="30"
                        Margin="0,5,0,0"
                        Clicked="PickImageButton_Clicked"/>
            </VerticalStackLayout>
            <VerticalStackLayout>
                <Label Text="Стоимость, руб."
                       TextColor="Black"/>
                <Entry Text="{Binding Item.Price}"
                       TextColor="Black"
                       Placeholder="Ввести значение"
                       PlaceholderColor="Gray"/>
            </VerticalStackLayout>
            <VerticalStackLayout>
                <Label Text="Вес, г"
                       TextColor="Black"/>
                <Entry Text="{Binding Item.Weight}"
                       TextColor="Black"
                       Placeholder="Ввести значение"
                       PlaceholderColor="Gray"/>
            </VerticalStackLayout>
            <Border BackgroundColor="LightGray"/>
            <Label Text="Пищевая ценность на 100 г продукта" TextColor="Black" HorizontalTextAlignment="Center"/>
            <VerticalStackLayout>
                <Label Text="Белки, г"
                       TextColor="Black"/>
                <Entry Text="{Binding Item.NutritionalInfo.ProteinsPer100g}"
                       TextColor="Black"
                       Placeholder="Ввести значение"
                       PlaceholderColor="Gray"/>
            </VerticalStackLayout>
            <VerticalStackLayout>
                <Label Text="Жиры, г"
                       TextColor="Black"/>
                <Entry Text="{Binding Item.NutritionalInfo.FatsPer100g}"
                       TextColor="Black"
                       Placeholder="Ввести значение"
                       PlaceholderColor="Gray"/>
            </VerticalStackLayout>
            <VerticalStackLayout>
                <Label Text="Углеводы, г"
                       TextColor="Black"/>
                <Entry Text="{Binding Item.NutritionalInfo.CarbohydratesPer100g}"
                       TextColor="Black"
                       Placeholder="Ввести значение"
                       PlaceholderColor="Gray"/>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="0.4*, 0.6*">
                <Button Grid.Column="0"
                        Text="Отменить"
                        BackgroundColor="White"
                        BorderWidth="0.5"
                        BorderColor="LightGray"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Text="Сохранить"
                        BackgroundColor="LightBlue"
                        Command="{Binding SaveItemCommand}"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
