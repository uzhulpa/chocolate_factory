<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ChocolateFactory.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ChocolateFactory"
    xmlns:pages="clr-namespace:ChocolateFactory.Pages"
    Title="Шоколадная фабрика"
    Shell.FlyoutBehavior="Locked"
    Shell.FlyoutBackgroundColor="#64829B"
    Shell.FlyoutWidth="200">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Icon="candy_bar.png"
        Route="MainPage" />
    
    <ShellContent
        Title="Gifts"
        ContentTemplate="{DataTemplate pages:GiftsPage}"
        Icon="gift_card.png"
        Route="GiftsPage" />
    
    <ShellContent
        Title="Manage Menu"
        ContentTemplate="{DataTemplate pages:ManageMenuItemPage}"
        Icon="file_edit.png"
        Route="ManageMenuItemPage" />

</Shell>
